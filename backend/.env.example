# Copia este archivo como .env y ajusta los valores
NODE_ENV=development
PORT=4000

# PostgreSQL (docker compose up -d)
DATABASE_URL="postgresql://sigepp:sigepp@localhost:5432/sigepp?schema=public"
DATABASE_URL_TEST="postgresql://sigepp:sigepp@localhost:5432/sigepp_test?schema=public"

# Origen permitido por CORS (frontend de Vite)
CORS_ORIGIN=http://localhost:5173

# JWT — usa cadenas largas y aleatorias (mínimo 32 caracteres)
JWT_ACCESS_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Dominios de correo institucional aceptados para estudiantes y docentes (RF-01)
DOMINIOS_INSTITUCIONALES=uni.edu.ni,std.uni.edu.ni

# Costo de bcrypt (RNF-05: no menor a 12)
BCRYPT_COST=12
